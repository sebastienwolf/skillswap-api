includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes

    level: 6

    ignoreErrors:
        # PHPStan 2 a retiré le paramètre `checkMissingIterableValueType` :
        # ces vérifications sont désormais toujours actives. On les ignore
        # globalement (comme le faisait l'ancien paramètre) plutôt que
        # d'annoter manuellement chaque tableau/iterable du projet, ce qui
        # serait disproportionné pour un portfolio de cette taille.
        - '#has no value type specified in iterable type#'
