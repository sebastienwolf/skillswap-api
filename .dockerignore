# Contexte de build allégé : ces fichiers n'ont rien à faire dans l'image
# (dépendances déjà réinstallées par `composer install`, secrets locaux,
# artefacts de qualité, historique git...).
.git
.github
vendor
node_modules
.env
.env.backup
.env.production
.phpunit.result.cache
.phpunit.cache
.phpstan.cache
# Caches Laravel générés localement (ex : manifeste des providers, incluant
# ceux des paquets de dev comme laravel/pail). Absents de l'image de toute
# façon puisqu'ils sont hors du suivi Git, mais Docker ne respecte pas
# .gitignore : sans cette ligne, `COPY . .` les copierait tels quels si un
# `composer install` complet a déjà tourné sur la machine hôte, et l'image
# échouerait à démarrer (classe d'un paquet de dev absente du conteneur).
bootstrap/cache/*.php
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
docker-compose.yml
docker-compose.sail.yml
README.md
